PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_home

DATABASE_URL="mysql://root:@127.0.0.1:3306/smart_home"

# Ohstem Cloud / Yolobit integration
OHSTEM_API_BASE_URL=
OHSTEM_API_KEY=

# JWT auth
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Face ID (door unlock via face-api.js) — see docs/FACE-ID-USAGE.md
# Max euclidean distance between two face embeddings to count as a match (lower = stricter).
# Tune against real enrollment photos; 0.6 is face-api.js's common default, not validated for this project yet.
FACE_MATCH_THRESHOLD=0.6
