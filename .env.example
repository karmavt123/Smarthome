# ── MySQL ───────────────────────────────────────
MYSQL_ROOT_PASSWORD=smarthome123
MYSQL_DATABASE=smart_home

# ── Backend ─────────────────────────────────────
BACKEND_PORT=3000

# Host la "mysql" (ten service trong compose), KHONG phai localhost.
# Mat khau chi dung chu + so de khoi phai URL-encode.
DATABASE_URL=mysql://root:smarthome123@mysql:3306/smart_home

# Sinh moi cai bang:
#   docker run --rm node:20-slim node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Hai secret BAT BUOC khac nhau va dai >= 32 ky tu.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Chay seed moi lan boot. Seed idempotent nen chay lai vo hai.
SEED_ON_BOOT=true

# Ket noi toi ai-service. Backend goi lazy - service chet thi chi mat
# Face ID + giong noi, phan con lai van chay (tra 503).
AI_SERVICE_URL=http://ai-service:5000
AI_SERVICE_API_KEY=dev-local-face-id-key

# Khoang cach Euclid toi da giua 2 embedding de coi la cung mot nguoi.
# ArcFace (512-d, da chuan hoa L2) - KHONG phai thang do cua face-api.js.
# CHUA HIEU CHINH - xem muc 10 trong README.
FACE_MATCH_THRESHOLD=1.24

PAIRING_TOKEN_TTL_MINUTES=10

# --- Thiet bi ---
DEVICE_HEARTBEAT_SECONDS=5
DEVICE_OFFLINE_AFTER_SECONDS=60
DEVICE_COMMAND_TTL_SECONDS=30

# --- Simulator (thiet bi ao co device_code bat dau bang "sim-") ---
SIMULATOR_ENABLED=true
SIMULATOR_READING_SECONDS=5
SIMULATOR_COMMAND_DELAY_MS=800

# Ti le lenh mo phong CO TINH that bai (0 - 1), de test duong xu ly loi.
# DAT VE 0 TRUOC KHI DEMO.
SIMULATOR_COMMAND_FAILURE_RATE=0

# ── ai-service ──────────────────────────────────
AI_SECRET_KEY=doi-chuoi-nay-di

# Diem "that" toi thieu de qua kiem tra chong gia mao (MiniFASNet).
# CHUA HIEU CHINH - xem muc 10 trong README.
LIVENESS_THRESHOLD=0.70

# Cosine similarity toi thieu de nhan mot cau la lenh.
# Do 22/08/2026 tren fastembed 0.8.0 (mean pooling):
#   lenh that 0.785-1.000 | ngoai mien 0.351-0.674
# Doi phien ban fastembed => PHAI do lai.
VOICE_INTENT_THRESHOLD=0.73

# Gioi han kich thuoc anh tai len (10 MB)
MAX_CONTENT_LENGTH=10485760

# ── MQTT (OhStem) ───────────────────────────────
MQTT_ENABLED=true
MQTT_BROKER_URL=mqtt://mqtt.ohstem.vn:1883
MQTT_USERNAME=
MQTT_PASSWORD=1

# ── Frontend ────────────────────────────────────
FRONTEND_PORT=8000
VITE_API_URL=/api
