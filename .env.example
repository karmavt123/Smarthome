FLASK_APP=run.py
FLASK_DEBUG=true
SECRET_KEY=development-secret-key
UPLOAD_FOLDER=storage/uploads
PORT=5000                # macOS AirPlay Receiver often squats on 5000 — set e.g. 5001 if so

# Face ID
AI_SERVICE_API_KEY=       # same value as Node .env AI_SERVICE_API_KEY
MODEL_DIR=models          # holds liveness ONNX weight (gitignored, download separately)
LIVENESS_THRESHOLD=0.9    # min real-class score to pass liveness (Python-owned, unlike face-match threshold)
