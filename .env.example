PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_home

DATABASE_URL="mysql://root:@127.0.0.1:3306/smart_home"

# Ohstem Cloud / Yolobit integration
OHSTEM_API_BASE_URL=
OHSTEM_API_KEY=

# JWT auth
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Face ID (door unlock via face) — see docs/NODE-INTEGRATION-FOR-FACE-ID.md
# ai-service (separate Python repo) does detection/embedding/liveness; Node keeps business logic.
AI_SERVICE_URL=http://localhost:5001
AI_SERVICE_API_KEY=dev-local-face-id-key

# Max euclidean distance between two face embeddings to count as a match (lower = stricter).
# Tune against real enrollment photos; not validated for this project's ArcFace embeddings yet.
FACE_MATCH_THRESHOLD=0.6
