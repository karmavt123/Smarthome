# QUAN TRONG ve cu phap: python-dotenv chi cat inline comment khi truoc dau '#' CO gia
# tri. Voi mot khoa de TRONG, ca doan '# ...' tro thanh gia tri thuc. Truoc day dong
# AI_SERVICE_API_KEY de trong kem comment, nen moi ai chay `cp .env.example .env` deu
# nhan API key = chinh cau comment do — mot chuoi nam san trong repo, tuc la ai cung goi
# duoc ai-service. Vi vay: comment luon nam o DONG RIENG, khong bao gio cung dong voi
# mot khoa de trong.

FLASK_APP=run.py

# De 'false'. Bat debug se mo Werkzeug console; run.py bind 0.0.0.0 nen console do lo ra
# toan mang LAN.
FLASK_DEBUG=false

SECRET_KEY=development-secret-key
UPLOAD_FOLDER=storage/uploads
PORT=5000

# --- Face ID ---
# Phai trung voi AI_SERVICE_API_KEY trong .env cua Node. De trong = tu choi moi request
# (fail closed) — dung nhu mong muon khi chua cau hinh.
AI_SERVICE_API_KEY=

# Thu muc chua file ONNX chong gia mao (gitignored, tai rieng)
MODEL_DIR=models

# Diem toi thieu de qua vong kiem tra la nguoi that. 0.90 do tu 20 anh that / 18 anh gia.
LIVENESS_THRESHOLD=0.90

# --- Voice Intent ---
# Cosine toi thieu so voi cau mau truoc khi tra 422 unknown_command
VOICE_INTENT_THRESHOLD=0.72

# Origin duoc phep goi tu trinh duyet, ngan cach bang dau phay. De trong = khong cho
# cross-origin nao (backend goi noi bo khong bi anh huong).
AI_ALLOWED_ORIGINS=
