PORT=3000

# Chuỗi kết nối MySQL. Đây là biến DUY NHẤT quyết định kết nối DB.
# Mật khẩu có ký tự đặc biệt phải URL-encode: @ -> %40, # -> %23, : -> %3A
DATABASE_URL="mysql://root:matkhau@127.0.0.1:3306/smart_home"

# JWT auth — sinh mỗi cái bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Hai secret PHẢI khác nhau.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ai-service (repo Python riêng) — Face ID + phân loại ý định giọng nói.
# Không có service này thì 2 tính năng đó báo lỗi, phần còn lại chạy bình thường.
AI_SERVICE_URL=http://localhost:5050
AI_SERVICE_API_KEY=dev-local-face-id-key
FACE_MATCH_THRESHOLD=0.6

# Thời gian sống của pairing token (phút)
PAIRING_TOKEN_TTL_MINUTES=10

# --- Thiết bị ---
DEVICE_HEARTBEAT_SECONDS=5          # nhịp báo sống
DEVICE_OFFLINE_AFTER_SECONDS=15     # im lặng quá lâu thì coi là offline
DEVICE_COMMAND_TTL_SECONDS=30       # lệnh treo quá lâu thì hết hạn

# --- Simulator (thiết bị ảo có device_code bắt đầu bằng "sim-") ---
SIMULATOR_ENABLED=true              # tắt bằng đúng chuỗi: false
SIMULATOR_READING_SECONDS=5         # bao lâu sinh một số đo
SIMULATOR_COMMAND_DELAY_MS=800      # độ trễ giả lập khi bật/tắt

# Tỉ lệ lệnh giả lập CỐ TÌNH thất bại (0 - 1). Có để test đường xử lý lỗi.
# ĐẶT VỀ 0 TRƯỚC KHI DEMO — nếu không cứ ~12 lần bấm là 1 lần báo lỗi.
SIMULATOR_COMMAND_FAILURE_RATE=0.08